# Samay Care — environment configuration
#
# None of these are required for the site to build or run. Until they are
# set, the pre-launch form and analytics adapter fall back to a safe no-op
# (leads are logged server-side only; analytics events are dropped).

# Pre-launch lead capture backend (server-side only — never expose with
# NEXT_PUBLIC_*). Configure once a lead-storage/CRM endpoint exists.
SAMAYCARE_LEAD_API_URL=
SAMAYCARE_LEAD_API_KEY=

# Analytics ingestion endpoint (server-side only). Configure once a product
# analytics provider (e.g. an internal collector) is available.
SAMAYCARE_ANALYTICS_API_URL=
SAMAYCARE_ANALYTICS_API_KEY=

# Zoho Mail SMTP (server-side only). Once set, /api/leads emails
# LEAD_NOTIFICATION_EMAIL for every new lead and sends the submitter a
# branded thank-you email (only if they gave an email address). See
# docs/PENDING_INTEGRATIONS.md for setup steps.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
EMAIL_FROM_NAME=Samay Care
# Where new-lead notifications go. Defaults to ZOHO_SMTP_USER if unset.
LEAD_NOTIFICATION_EMAIL=

# Google Sheets lead log (server-side only). Once set, /api/leads appends a
# row per lead. See docs/PENDING_INTEGRATIONS.md for setup steps.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Leads

# Public site URL, used for canonical/OG metadata, sitemap generation, and
# links/logo images in transactional emails.
NEXT_PUBLIC_SITE_URL=https://samaycare.com
