# Samay Care — environment configuration
#
# None of these are required for the site to build or run. Until they are
# set, the pre-launch form and analytics adapter fall back to a safe no-op
# (leads are logged server-side only; analytics events are dropped).

# Pre-launch lead capture backend (server-side only — never expose with
# NEXT_PUBLIC_*). Configure once a lead-storage/CRM endpoint exists.
SAMAYCARE_LEAD_API_URL=
SAMAYCARE_LEAD_API_KEY=

# Analytics ingestion endpoint (server-side only). Configure once a product
# analytics provider (e.g. an internal collector) is available.
SAMAYCARE_ANALYTICS_API_URL=
SAMAYCARE_ANALYTICS_API_KEY=

# Public site URL, used for canonical/OG metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://samaycare.com
